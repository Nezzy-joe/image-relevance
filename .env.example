# Local development values only. Replace them before exposing services beyond localhost.
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info

# The existing flyrank database/user and postgres_data volume are retained for local data compatibility.
POSTGRES_DB=flyrank
POSTGRES_USER=flyrank
POSTGRES_PASSWORD=flyrank_dev_password
POSTGRES_PORT=15432
# Optional local override. Production requires an explicit, managed DATABASE_URL.
DATABASE_URL=

DB_CONNECT_TIMEOUT=5s
DB_READINESS_TIMEOUT=2s
DB_MAX_CONNS=10
SHUTDOWN_TIMEOUT=10s

# Gemini API credentials are required only for the optional AI worker profile.
# Configure locally; never commit a populated .env file.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
IMAGE_STORAGE_PATH=./data/images
MAX_IMAGE_BYTES=10485760
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL=500ms
VISION_CONFIDENCE_FLOOR=0.65
MATCH_SIMILARITY_FLOOR=0.35
